type Query {
    pagBankThreeDsSession: ThreeDsSessionOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ThreeDsSession") @cache(cacheable: false)
    pagBankListInstallments(input: PagBankListInstallmentsInput!): [PagBankInstallmentPlan]! @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ListInstallments") @cache(cacheable: false)
    pagBankGuestListInstallments(input: PagBankGuestListInstallmentsInput!): [PagBankInstallmentPlan]! @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\GuestListInstallments") @cache(cacheable: false)
}

type Mutation {
    pagBankApplyInterest(input: PagBankInterestInput!): PagBankInterestOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ApplyInterest") @cache(cacheable: false)
    pagBankGuestApplyInterest(input: PagBankGuestInterestInput!): PagBankInterestOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\GuestApplyInterest") @cache(cacheable: false)
    pagBankCreateVaultToken(input: PagBankCreateVaultTokenInput!): PagBankVaultTokenOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\CreateVaultToken") @cache(cacheable: false)
}

type ThreeDsSessionOutput {
    session_id: String!
    expires_at: String!
}

input PaymentMethodInput {
    pagbank_paymentmagento_cc: PagBankCcInput
    pagbank_paymentmagento_cc_vault: PagBankCcVaultInput
    pagbank_paymentmagento_boleto: PagBankBoletoInput
    pagbank_paymentmagento_pix: PagBankPixInput
    pagbank_paymentmagento_deep_link: PagBankDeepLinkInput
}

input PagBankCcInput {
    cc_number_token: String!
    cc_installments: Int!
    cc_cardholder_name: String!
    payer_tax_id: String
    payer_phone: String
    is_active_payment_token_enabler: Boolean
    cc_cid: String
    card_type_transaction: String
    three_ds_session: String
    three_ds_auth: String
    three_ds_auth_status: String
}

input PagBankCcVaultInput {
    public_hash: String!
    cc_installments: Int!
    payer_tax_id: String
    payer_phone: String
    card_type_transaction: String
    three_ds_session: String
    three_ds_auth: String
    three_ds_auth_status: String
}

input PagBankBoletoInput {
    payer_name: String
    payer_tax_id: String!
    payer_phone: String
}

input PagBankPixInput {
    payer_name: String
    payer_tax_id: String
    payer_phone: String
}

input PagBankDeepLinkInput {
    payer_name: String
    payer_tax_id: String
    payer_phone: String
}

input CreditCardBinInput {
    credit_card_bin: String!
}

input CardTypeTransactionInput {
    card_type_transaction: String
}

input InstallmentSelectedInput {
    installment_selected: Int!
}

input PagBankListInstallmentsInput {
    cart_id: String
    credit_card_bin: CreditCardBinInput!
    card_type_transaction: CardTypeTransactionInput
}

input PagBankGuestListInstallmentsInput {
    cart_id: String!
    credit_card_bin: CreditCardBinInput!
    card_type_transaction: CardTypeTransactionInput
}

input PagBankInterestInput {
    cart_id: String
    credit_card_bin: CreditCardBinInput!
    installment_selected: InstallmentSelectedInput!
}

input PagBankGuestInterestInput {
    cart_id: String!
    credit_card_bin: CreditCardBinInput!
    installment_selected: InstallmentSelectedInput!
}

input PagBankCreateVaultTokenInput {
    encrypted_card: String!
}

type ThreeDsSessionOutput {
    session_id: String!
    expires_at: String!
}

type PagBankInstallmentPlan {
    installments: Int!
    installment_value: Int!
    interest_free: Boolean!
    amount: PagBankAmount!
}

type PagBankAmount {
    value: Int!
    fees: PagBankFees
}

type PagBankFees {
    buyer: PagBankBuyerFees
}

type PagBankBuyerFees {
    interest: PagBankInterestDetails
}

type PagBankInterestDetails {
    total: Int!
}

type PagBankInterestOutput {
    cart: Cart!
}

type PagBankVaultTokenOutput {
    pagbank_token: String!
    public_hash: String!
    card_brand: String!
    last_digits: String!
    expiration_date: String
    created_at: String
    is_active: Boolean!
    website_id: Int!
}