type Query {
    pagBankThreeDsSession: ThreeDsSessionOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ThreeDsSession") @cache(cacheable: false)
    pagBankListInstallments(input: PagBankListInstallmentsInput!): [PagBankInstallmentPlan]! @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ListInstallments") @cache(cacheable: false)
    pagBankGuestListInstallments(input: PagBankGuestListInstallmentsInput!): [PagBankInstallmentPlan]! @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\GuestListInstallments") @cache(cacheable: false)
}

type Mutation {
    pagBankApplyInterest(input: PagBankInterestInput!): PagBankInterestOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\ApplyInterest") @cache(cacheable: false)
    pagBankGuestApplyInterest(input: PagBankGuestInterestInput!): PagBankInterestOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\GuestApplyInterest") @cache(cacheable: false)
    pagBankCreateVaultToken(input: PagBankCreateVaultTokenInput!): PagBankVaultTokenOutput @resolver(class: "PagBank\\PaymentMagento\\Model\\Resolver\\CreateVaultToken") @cache(cacheable: false)
}

type ThreeDsSessionOutput {
    session_id: String!
    expires_at: String!
}

type Query {
    pagBankGetOrderPaymentInfo(
        input: PagBankGetOrderPaymentInfoInput! @doc(description: "Input parameters for retrieving order payment information")
    ): PagBankOrderPaymentInfo @resolver(class: "\\PagBank\\PaymentMagento\\Model\\Resolver\\GetOrderPaymentInfo") @doc(description: "Returns payment information for a PagBank order") @cache(cacheable: false)
}

input PagBankGetOrderPaymentInfoInput @doc(description: "Input for retrieving order payment information") {
    order_id: Int @doc(description: "Order ID")
    increment_id: String @doc(description: "Order increment ID")
    guest_email: String @doc(description: "Guest email for non-logged in customers")
}

type PagBankOrderPaymentInfo @doc(description: "PagBank order payment information") {
    order_id: Int! @doc(description: "Order ID")
    increment_id: String! @doc(description: "Order increment ID")
    payment_method: String! @doc(description: "Payment method code")
    payment_status: String! @doc(description: "Current payment status")
    created_at: String! @doc(description: "Order creation date")
    grand_total: Float! @doc(description: "Order grand total")
    currency_code: String! @doc(description: "Order currency code")
    pagbank_order_id: String @doc(description: "PagBank order/transaction ID")
    payment_type: String! @doc(description: "Payment type (credit_card, boleto, pix, deep_link)")
    additional_information: PagBankAdditionalInformation @doc(description: "Common additional information")
    credit_card_details: PagBankCreditCardDetails @doc(description: "Credit card payment details")
    boleto_details: PagBankBoletoDetails @doc(description: "Boleto payment details")
    pix_details: PagBankPixDetails @doc(description: "PIX payment details")
    deep_link_details: PagBankDeepLinkDetails @doc(description: "Deep Link payment details")
}

type PagBankAdditionalInformation @doc(description: "Common PagBank additional information") {
    payer_name: String @doc(description: "Payer name")
    payer_tax_id: String @doc(description: "Payer tax ID")
    payer_phone: String @doc(description: "Payer phone number")
    charge_id: String @doc(description: "PagBank charge ID")
}

type PagBankCreditCardDetails @doc(description: "Credit card payment details") {
    cc_type: String @doc(description: "Credit card type (VI, MC, DN...)")
    cc_number: String @doc(description: "Credit card number (414141*******4141)")
    cc_exp_month: String @doc(description: "Credit card expiration month")
    cc_exp_year: String @doc(description: "Credit card expiration year")
    cc_installments: Int @doc(description: "Number of installments")
    cc_cardholder_name: String @doc(description: "Cardholder name")
    cc_authorization_code: String @doc(description: "Authorization Code")
    cc_nsu: String @doc(description: "NSU")
    three_ds_auth_status: String @doc(description: "3DS State")
    pagbank_interest_amount: Float @doc(description: "Interest amount")
}

type PagBankBoletoDetails @doc(description: "Boleto payment details") {
    boleto_pdf_href: String @doc(description: "Boleto URL")
    boleto_line_code: String @doc(description: "Boleto barcode")
    expiration_date: String @doc(description: "Boleto expiration date")
}

type PagBankPixDetails @doc(description: "PIX payment details") {
    qr_code_image: String @doc(description: "PIX QR code image URL")
    qr_code: String @doc(description: "PIX copy and paste code")
    expiration_date: String @doc(description: "PIX expiration date")
}

type PagBankDeepLinkDetails @doc(description: "Deep Link payment details") {
    qr_code_url_image: String @doc(description: "Deep link URL")
    deep_link_url: String @doc(description: "Deep link QR code image URL")
    expiration_date: String @doc(description: "Deep link expiration date")
}

input PaymentMethodInput {
    pagbank_paymentmagento_cc: PagBankCcInput
    pagbank_paymentmagento_cc_vault: PagBankCcVaultInput
    pagbank_paymentmagento_boleto: PagBankBoletoInput
    pagbank_paymentmagento_pix: PagBankPixInput
    pagbank_paymentmagento_deep_link: PagBankDeepLinkInput
}

input PagBankCcInput {
    cc_number_token: String!
    cc_installments: Int!
    cc_cardholder_name: String!
    payer_tax_id: String
    payer_phone: String
    is_active_payment_token_enabler: Boolean
    cc_cid: String
    card_type_transaction: String
    three_ds_session: String
    three_ds_auth: String
    three_ds_auth_status: String
}

input PagBankCcVaultInput {
    public_hash: String!
    cc_installments: Int!
    payer_tax_id: String
    payer_phone: String
    card_type_transaction: String
    three_ds_session: String
    three_ds_auth: String
    three_ds_auth_status: String
}

input PagBankBoletoInput {
    payer_name: String
    payer_tax_id: String!
    payer_phone: String
}

input PagBankPixInput {
    payer_name: String
    payer_tax_id: String
    payer_phone: String
}

input PagBankDeepLinkInput {
    payer_name: String
    payer_tax_id: String
    payer_phone: String
}

input CreditCardBinInput {
    credit_card_bin: String!
}

input CardTypeTransactionInput {
    card_type_transaction: String
}

input InstallmentSelectedInput {
    installment_selected: Int!
}

input PagBankListInstallmentsInput {
    cart_id: String
    credit_card_bin: CreditCardBinInput!
    card_type_transaction: CardTypeTransactionInput
}

input PagBankGuestListInstallmentsInput {
    cart_id: String!
    credit_card_bin: CreditCardBinInput!
    card_type_transaction: CardTypeTransactionInput
}

input PagBankInterestInput {
    cart_id: String
    credit_card_bin: CreditCardBinInput!
    installment_selected: InstallmentSelectedInput!
}

input PagBankGuestInterestInput {
    cart_id: String!
    credit_card_bin: CreditCardBinInput!
    installment_selected: InstallmentSelectedInput!
}

input PagBankCreateVaultTokenInput {
    encrypted_card: String!
}

type ThreeDsSessionOutput {
    session_id: String!
    expires_at: String!
}

type PagBankInstallmentPlan {
    installments: Int!
    installment_value: Int!
    interest_free: Boolean!
    amount: PagBankAmount!
}

type PagBankAmount {
    value: Int!
    fees: PagBankFees
}

type PagBankFees {
    buyer: PagBankBuyerFees
}

type PagBankBuyerFees {
    interest: PagBankInterestDetails
}

type PagBankInterestDetails {
    total: Int!
}

type PagBankInterestOutput {
    cart: Cart!
}

type PagBankVaultTokenOutput {
    pagbank_token: String!
    public_hash: String!
    card_brand: String!
    last_digits: String!
    expiration_date: String
    created_at: String
    is_active: Boolean!
    website_id: Int!
}